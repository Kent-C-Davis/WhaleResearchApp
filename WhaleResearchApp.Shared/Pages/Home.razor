@page "/"

<PageTitle>Whale Research</PageTitle>

<div class="page-header">
    <h1>Whale Research Forms</h1>
    <p>
        Select a form to begin data collection.
    </p>
</div>

<div class="form-grid">

    <div class="form-card">
        <h3>Research Logbook</h3>
        <p>Compact trip log with sightings notes and photo references.</p>
        <a href="/logbook" class="form-button">
            Open Form
        </a>

    </div>


    <div class="form-card">
        <h3>Newborn</h3>
        <p>Environmental conditions plus newborn observation details, scar-condition mapping, and associated species comments.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>COS Study</h3>
        <p>Long-form Calf of Season sheet with behavior groups, scar conditions, and conditional detail fields.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Dolphin Sightings</h3>
        <p>Compact mixed-species support sheet with free-text photo references and details.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Mugging Study</h3>
        <p>Trip details, pod counts, repeatable approach cards, and associated species counts.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Other Species</h3>
        <p>Non-target species observations with conditional species detail and GPS start/end fields.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Two Minute Study</h3>
        <p>Trip setup plus repeatable timed observation records for the two-minute study workflow.</p>
        <button class="form-button">Open Form</button>
    </div>

</div>