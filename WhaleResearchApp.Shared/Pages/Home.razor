@page "/"


<PageTitle>Whale Research</PageTitle>

<div class="page-header">
    <h1>Whale Research Forms</h1>
    <p>
        Select a form to begin data collection.
    </p>
</div>

<div class="form-grid">

    <div class="form-card">
        <h3>Research Logbook</h3>
        <p>Record trip details, sightings and photo references.</p>
        <a href="/logbook" class="form-button">
            Open Form
        </a>

    </div>


    <div class="form-card">
        <h3>Newborn</h3>
        <p>Record observations of newborn animals.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>COS Study</h3>
        <p>Cetacean observation study records.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Dolphin Sightings</h3>
        <p>Record dolphin and whale encounters.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Mugging Study</h3>
        <p>Document vessel interactions.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Other Species</h3>
        <p>Log encounters outside primary studies.</p>
        <button class="form-button">Open Form</button>
    </div>


    <div class="form-card">
        <h3>Two Minute Study</h3>
        <p>Rapid behavioural observations.</p>
        <button class="form-button">Open Form</button>
    </div>

</div>