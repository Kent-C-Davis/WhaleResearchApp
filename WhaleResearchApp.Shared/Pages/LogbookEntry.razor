@page "/logbook"

<h1>Research Logbook</h1>

<div class="logbook-container">

    <div class="form-group">
        <label>Date</label>
        <input type="date" />
    </div>

    <div class="form-group">
        <label>Skipper</label>
        <input type="text" />
    </div>

    <div class="form-group">
        <label>Researchers</label>
        <input type="text" />
    </div>

    <div class="form-group">
        <label>Tour Time</label>
        <input type="time" />
    </div>

    <div class="form-group">
        <label>Sightings</label>
        <textarea></textarea>
    </div>

    <div class="form-group">
        <label>Photos Reference</label>
        <input type="text" />
    </div>

    <button class="save-button">
        Save Entry
    </button>

</div>