@page "/logbook"
@using WhaleResearchApp.Shared.Models
@using WhaleResearchApp.Shared.Services
@inject ILogbookService LogbookService

<h1>Research Logbook</h1>

<EditForm Model="entry" OnValidSubmit="SaveEntry">

    <DataAnnotationsValidator />

    <ValidationSummary />

    <div class="logbook-container">

        <div class="form-group">
            <label>Date</label>
            <InputDate @bind-Value="entry.TourDate" />
        </div>

        <div class="form-group">
            <label>Skipper</label>
            <InputText @bind-Value="entry.Skipper" />
        </div>

        <div class="form-group">
            <label>Researchers</label>
            <InputText @bind-Value="entry.Researchers" />
        </div>

        <div class="form-group">
            <label>Tour Time</label>
            <input type="time" 
                @bind="entry.TourTime" />
        </div>

        <div class="form-group">
            <label>Sightings</label>
            <InputTextArea @bind-Value="entry.Sightings" />
        </div>

        <div class="form-group">
            <label>Photos Reference</label>
            <InputText @bind-Value="entry.PhotosReference" />
        </div>

        <div class="form-group">
            <label>Newborn Sighted</label>
            <InputCheckbox @bind-Value="entry.NewbornSighted" />
        </div>

        <button type="submit" class="save-button">
            Save Entry
        </button>

        <p>@saveMessage</p>
    </div>

</EditForm>


@code {
    private LogbookEntry entry = new()
    {
        TourDate = DateOnly.FromDateTime(DateTime.Today),
        TourTime = TimeOnly.FromDateTime(DateTime.Now)
    };

    private string saveMessage = "";

    private async Task SaveEntry()
    {
        await LogbookService.Save(entry);

        saveMessage = "Entry saved successfully!";
    }
}