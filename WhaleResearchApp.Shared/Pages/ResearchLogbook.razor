@page "/logbook"
@using WhaleResearchApp.Shared.Models

<h1>Research Logbook</h1>

<div class="logbook-container">

    <div class="form-group">
        <label>Date</label>
        <InputDate @bind-Value="entry.TourDate" />
    </div>

    <div class="form-group">
        <label>Skipper</label>
        <InputText @bind-Value="entry.Skipper" />
    </div>

    <div class="form-group">
        <label>Researchers</label>
        <InputText @bind-Value="entry.Researchers" />
    </div>

    <div class="form-group">
        <label>Tour Time</label>
        <input type="time" 
            @bind="entry.TourTime" />
    </div>

    <div class="form-group">
        <label>Sightings</label>
        <InputTextArea @bind-Value="entry.Sightings" />
    </div>

    <div class="form-group">
        <label>Photos Reference</label>
        <InputText @bind-Value="entry.PhotosReference" />
    </div>

    <button class="save-button" @onclick="SaveEntry">
        Save Entry
    </button>

    <p>@saveMessage</p>
</div>

@code {
    private LogbookEntry entry = new();

    private string saveMessage = "";
    //need to change this function to write to file later
    private void SaveEntry()
    {
        System.Diagnostics.Debug.WriteLine($"Saved: TourDate: {entry.TourDate}");
        System.Diagnostics.Debug.WriteLine($"Saved: Skipper: {entry.Skipper}");
        System.Diagnostics.Debug.WriteLine($"Saved: Researchers: {entry.Researchers}");
        System.Diagnostics.Debug.WriteLine($"Saved: TourTime: {entry.TourTime}");
        System.Diagnostics.Debug.WriteLine($"Saved: Sightings: {entry.Sightings}");
        System.Diagnostics.Debug.WriteLine($"Saved: PhotosReference: {entry.PhotosReference}");
        saveMessage = "Entry saved successfully!";
    }
}